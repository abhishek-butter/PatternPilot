{
    "manifest_version":3,
    "name":"PatternPilot",
    "version":"0.0.1",
    "description":"Track your DSA Progress.",
    "permissions" : ["storage"],
    "action":{
       "default_popup": "popup/popup.html"
    },
    "content_scripts":[
        {
            "matches":[
                "https://leetcode.com/problems/*"
            ],
            "js":[
                "models/Submission.js",
                "models/Problem.js",
                "Storage/PatternPilotStorage.js",
                "content/content.js"]

        }
    ]
}